# Unifix - Environment Configuration Template

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# Supabase Storage & Services
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# JWT Authentication
JWT_ACCESS_SECRET="your-jwt-access-secret-32-chars-minimum"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-32-chars-minimum"
JWT_REFRESH_EXPIRES_IN="7d"
REFRESH_TOKEN_PEPPER="your-refresh-token-pepper-secret"

# AI Inference Integration
# Options: "mock" | "openai" | "ollama" | "custom"
AI_PROVIDER="mock"
AI_ENABLED=true
AI_BASE_URL="http://localhost:11434/v1"
AI_API_KEY=""
AI_MODEL="qwen-2.5-coder"
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX=100

# Application Server
PORT=3000
NODE_ENV="development"
WEB_ORIGIN="http://localhost:5173"
MOBILE_APP_SCHEME="unifix"
