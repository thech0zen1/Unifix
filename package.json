{
  "name": "unifix",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "apps/web",
    "services/api",
    "packages/shared-types",
    "packages/shared-schemas",
    "packages/shared-config"
  ],
  "scripts": {
    "dev": "nodemon --watch ./services/api --exec 'ts-node ./services/api/server.ts'",
    "build": "tsc",
    "start": "node ./services/api/dist/server.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "express": "^4.18.2",
    "prisma": "^5.22.0",
    "typescript": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/node": "^20.11.8",
    "dotenv": "^18.0.9",
    "nodemon": "^3.0.1"
  }
}
